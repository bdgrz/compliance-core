<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Cntryl.Conventions.Testing.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Cntryl.Conventions.Testing.CodeFixes" PrivateAssets="all" />
    <PackageReference Include="Cntryl.Fitz.Testing" />
    <PackageReference Include="Cntryl.Portia.Mcp.Testing" />
    <PackageReference Include="Cntryl.Portia.Testing" />
    <PackageReference Include="Cntryl.Portia.Analyzers" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Compliance.Common/Compliance.Common.csproj" />
    <ProjectReference Include="../../src/Compliance.Core/Compliance.Core.csproj" />
    <ProjectReference Include="../../src/Compliance.App/Compliance.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="E2E/compose.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="E2E/recovery.compose.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/product/aggregate-command-coverage.json" Link="aggregate-command-coverage.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
