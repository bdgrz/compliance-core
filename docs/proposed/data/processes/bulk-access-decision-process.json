{
  "process": "BulkAccessDecisionProcess",
  "rootSourceEvents": [
    "AccessReviewDecisionBatchAdmitted"
  ],
  "ordered": true,
  "stages": [
    {
      "stage": "materialize",
      "receivers": [
        "MaterializeAccessReviewDecisionBatch"
      ]
    },
    {
      "stage": "reserve",
      "receivers": [
        "ReserveAccessReviewItemDecision"
      ],
      "rule": "All selected items in canonical order before any apply."
    },
    {
      "stage": "apply",
      "receivers": [
        "ApplyAccessReviewItemDecision"
      ],
      "rule": "All items; provisional and hidden."
    },
    {
      "stage": "publish",
      "receivers": [
        "PublishAccessReviewDecisionBatch"
      ],
      "rule": "One publication fact."
    },
    {
      "stage": "settle",
      "receivers": [
        "SettleAccessReviewItemDecision"
      ]
    }
  ],
  "abort": [
    "CancelAccessReviewDecisionBatch"
  ],
  "abortStages": [
    {
      "stage": "fence",
      "receivers": [
        "FenceAccessReviewItemDecision"
      ],
      "rule": "Every item, including not-yet-acquired holds."
    },
    {
      "stage": "complete",
      "receivers": [
        "CompleteAccessReviewDecisionBatchCancellation"
      ]
    },
    {
      "stage": "settle",
      "receivers": [
        "SettleAccessReviewItemDecision"
      ]
    }
  ]
}
