{
  "process": "IdentityRecoveryProcess",
  "rootSourceEvents": [
    "IdentityRecoveryChallengeClaimed"
  ],
  "ordered": true,
  "stages": [
    {
      "stage": "prepare",
      "receivers": [
        "MaterializeIdentityRecoveryPreparation"
      ]
    },
    {
      "stage": "protect",
      "receivers": [
        "ProtectRecoveryIdentity"
      ],
      "rule": "Old and replacement slots in canonical key order."
    },
    {
      "stage": "accept",
      "receivers": [
        "AcceptProtectedIdentityRecovery"
      ],
      "rule": "Irreversible; no cancellation afterwards."
    },
    {
      "stage": "register",
      "receivers": [
        "RegisterRecoveredIdentity"
      ]
    },
    {
      "stage": "revoke",
      "receivers": [
        "RevokeRecoveredOldIdentity"
      ],
      "rule": "Only with authoritative replacement proof."
    },
    {
      "stage": "complete",
      "receivers": [
        "CompleteAcceptedIdentityRecovery"
      ]
    },
    {
      "stage": "settle",
      "receivers": [
        "SettleRecoveryIdentityProtection",
        "CompleteEmailRecoveryChallenge",
        "SendIdentityRecoveryNotice"
      ],
      "rule": "Independent; the notice cannot hold completion hostage."
    }
  ],
  "abort": [
    "RejectIdentityRecoveryPreparation"
  ]
}
