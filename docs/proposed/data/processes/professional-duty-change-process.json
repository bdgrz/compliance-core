{
  "process": "ProfessionalDutyChangeProcess",
  "rootSourceEvents": [
    "ProfessionalDutyChangeAccepted"
  ],
  "ordered": true,
  "stages": [
    {
      "stage": "acquire",
      "receivers": [
        "AuthorizeFirmStaffProfessionalDutyUse"
      ],
      "rule": "Recording only; revocation skips this stage."
    },
    {
      "stage": "claim",
      "receivers": [
        "ClaimProfessionalAssertionIdentity"
      ],
      "rule": "Permanent; never released."
    },
    {
      "stage": "apply",
      "receivers": [
        "ApplyProfessionalDutyChange"
      ],
      "rule": null
    },
    {
      "stage": "settle",
      "receivers": [
        "SettleFirmStaffProfessionalDutyUse"
      ],
      "rule": null
    }
  ],
  "abort": [
    "RejectProfessionalDutyChange"
  ]
}
