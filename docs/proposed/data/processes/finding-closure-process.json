{
  "process": "FindingClosureProcess",
  "rootSourceEvents": [
    "FindingClosureAccepted"
  ],
  "ordered": true,
  "stages": [
    {
      "stage": "acquire",
      "receivers": [
        "AuthorizeCorrectiveActionFindingClosureUse"
      ]
    },
    {
      "stage": "complete",
      "receivers": [
        "CompleteFindingClosure"
      ]
    },
    {
      "stage": "settle",
      "receivers": [
        "SettleCorrectiveActionFindingClosureUse"
      ]
    }
  ],
  "abort": [
    "AbortFindingClosure"
  ]
}
