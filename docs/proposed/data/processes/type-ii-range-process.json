{
  "process": "TypeIIRangeProcess",
  "rootSourceEvents": [
    "TypeIIPeriodOpeningAccepted",
    "TypeIIPeriodAmendmentAccepted"
  ],
  "ordered": true,
  "stages": [
    {
      "stage": "acquire",
      "receivers": [
        "AcquireTypeIIPeriodRange"
      ],
      "rule": "Old and new range held until applied."
    },
    {
      "stage": "apply",
      "receivers": [
        "ApplyTypeIIPeriodRange"
      ]
    },
    {
      "stage": "settle",
      "receivers": [
        "SettleTypeIIPeriodRange"
      ]
    }
  ],
  "abort": [
    "RejectTypeIIPeriodOpening",
    "RejectTypeIIPeriodAmendment",
    "CancelTypeIIPeriodAmendment"
  ]
}
