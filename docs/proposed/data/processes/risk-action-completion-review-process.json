{
  "process": "RiskActionCompletionReviewProcess",
  "rootSourceEvents": [
    "RiskTreatmentActionCompletionReviewAccepted"
  ],
  "ordered": true,
  "stages": [
    {
      "stage": "acquire",
      "receivers": [
        "AuthorizeEvidenceRequestActionCompletionUse"
      ]
    },
    {
      "stage": "complete",
      "receivers": [
        "CompleteRiskTreatmentActionReview"
      ]
    },
    {
      "stage": "settle",
      "receivers": [
        "SettleEvidenceRequestActionCompletionUse"
      ]
    }
  ],
  "abort": [
    "AbortRiskTreatmentActionReview"
  ]
}
