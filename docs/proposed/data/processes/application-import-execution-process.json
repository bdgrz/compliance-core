{
  "process": "ApplicationImportExecutionProcess",
  "rootSourceEvents": [
    "ApplicationImportPlanSealed"
  ],
  "ordered": true,
  "stages": [
    {
      "stage": "claim",
      "receivers": [
        "ClaimApplicationImportSource"
      ]
    },
    {
      "stage": "reserve",
      "receivers": [
        "ReserveApplicationImportTarget"
      ],
      "rule": "Every target group in canonical order before any apply; driven by ApplicationImportExecutionAuthorized."
    },
    {
      "stage": "apply",
      "receivers": [
        "ApplyApplicationImportEffect"
      ],
      "rule": "One preflighted native batch per target group."
    },
    {
      "stage": "publish",
      "receivers": [
        "CommitApplicationImportBatch"
      ],
      "rule": "One publication gate."
    },
    {
      "stage": "settle",
      "receivers": [
        "ReleaseApplicationImportTarget",
        "ReleaseApplicationImportSource"
      ]
    }
  ],
  "abort": [
    "CancelApplicationImport"
  ],
  "abortStages": [
    {
      "stage": "fence",
      "receivers": [
        "FenceApplicationImportTarget"
      ],
      "rule": "Every target, including not-yet-acquired holds."
    },
    {
      "stage": "complete",
      "receivers": [
        "CompleteApplicationImportCancellation"
      ]
    },
    {
      "stage": "settle",
      "receivers": [
        "ReleaseApplicationImportTarget",
        "ReleaseApplicationImportSource"
      ]
    }
  ]
}
