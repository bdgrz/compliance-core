{
  "process": "ProviderNameChangeProcess",
  "rootSourceEvents": [
    "ProviderChangeAccepted"
  ],
  "ordered": true,
  "stages": [
    {
      "stage": "claim",
      "receivers": [
        "ClaimProviderName"
      ],
      "rule": "New then old key in canonical order; hold both through apply."
    },
    {
      "stage": "apply",
      "receivers": [
        "ApplyProviderChange"
      ],
      "rule": null
    },
    {
      "stage": "release",
      "receivers": [
        "ReleaseProviderName"
      ],
      "rule": "Old matching generation only."
    }
  ],
  "abort": [
    "CancelProviderChange"
  ]
}
