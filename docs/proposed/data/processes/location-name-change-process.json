{
  "process": "LocationNameChangeProcess",
  "rootSourceEvents": [
    "LocationChangeAccepted"
  ],
  "ordered": true,
  "stages": [
    {
      "stage": "claim",
      "receivers": [
        "ClaimLocationName"
      ]
    },
    {
      "stage": "apply",
      "receivers": [
        "ApplyLocationChange"
      ]
    },
    {
      "stage": "release",
      "receivers": [
        "ReleaseLocationName"
      ]
    }
  ],
  "abort": [
    "CancelLocationChange"
  ]
}
