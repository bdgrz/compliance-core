{
  "process": "EmailChallengeDeliveryProcess",
  "rootSourceEvents": [
    "EmailChallengeIssued",
    "IdentityRecoveryChallengeIssued"
  ],
  "ordered": true,
  "stages": [
    {
      "stage": "deliver",
      "receivers": [
        "DeliverEmailChallenge",
        "DeliverRecoveryChallenge"
      ],
      "rule": "At-least-once; an unknown result is reconciled before the same message is resent."
    }
  ],
  "abort": []
}
