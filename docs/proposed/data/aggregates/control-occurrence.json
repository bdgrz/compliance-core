  "selectedReplayRule": "Current required authorization precedes replay; exact authorized retries resolve the original accepted result using the selected logical identity and immutable actor/intent/source binding. Fresh mutable feasibility, clock selection and body preparation cannot replace that original result. Expected revision is concurrency precondition, not a new identity.",
  "productRules": [
    {
      "id": "D19-02",
      "doc": "m0-d19-periodic-reviews.md",
      "rule": "A management compliance review's ControlOccurrence has a frozen evidence set binding the exact readiness assessment version, the monitoring measure versions, and the agenda or minutes artifact; later data changes never alter the frozen set; it replaces a separate ManagementReviewSnapshot aggregate."
    },
    {
      "id": "D19-03",
      "doc": "m0-d19-periodic-reviews.md",
      "rule": "Management's sign-off on the review occurrence is an immutable decision with outcome approved, action_requested, or deferred and a rationale."
    },
    {
      "id": "D19-05",
      "doc": "m0-d19-periodic-reviews.md",
      "rule": "Annual policy review is one occurrence per policy with evidence of the approved new or unchanged policy version; annual vendor review is one occurrence per material provider with evidence of the assurance-report review."
    }
  ],
  "decides": "Refuses to record a management compliance review sign-off unless the occurrence holds a frozen evidence set binding the exact readiness assessment version, the monitoring measure versions, and the agenda or minutes artifact; later data changes never alter that set. The sign-off is one immutable attributed decision with outcome approved, action_requested, or deferred and a rationale; policy, risk, vendor, and management reviews are ordinary recurring-control occurrences with no dedicated review aggregate.",
  "decidesCovers": [
    "D19-02",
    "D19-03"
  ],
