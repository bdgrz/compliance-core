      "sha256": "8fdaec764a3554f2ea470aba66f2ce0945a424adbeba7505684314655d62216f",
      "decisionId": "OWNER_AuditPopulationRowDecision",
      "choice": "parent_owns_current_reconciliation",
      "rationale": "Classification, reconciliation invalidation, complete-source proof and freeze seal are one conflict set on AuditPopulation. Immutable row/version bodies are values, not separate owners. Explicitly supersede the earlier row-root proposal; remove lifetime history coupling without splitting the seal.",
      "authority": "Explicit current architecture adjudication under user-directed Jev review; supersedes cited contradictory earlier candidate/locked labels only as stated. Documentation decision, not implementation or deployment qualification."
    }
