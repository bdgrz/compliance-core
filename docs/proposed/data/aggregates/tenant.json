  "selectedReplayRule": "Current required authorization precedes replay; exact authorized retries resolve the original accepted result using the selected logical identity and immutable actor/intent/source binding. Fresh mutable feasibility, clock selection and body preparation cannot replace that original result. Expected revision is concurrency precondition, not a new identity.",
  "productRules": [
    {
      "id": "D03-09",
      "doc": "m0-d03-roles-and-separation-of-duties.md",
      "rule": "There is exactly one workspace per organization; programs and engagements provide sub-scoping."
    }
  ],
  "decides": "There is exactly one workspace per organization, and the client organization is the only tenant boundary with tenant_id its sole technical name. Only platform operators suspend, reactivate or offboard, and suspension blocks every member and assigned firm staff while preserving records. Suspension stops new authenticated service for every member until an operator reactivates the tenant; reactivation requires the suspension to be the current state; offboarding starts only from active or suspended, forbids new active service, and completes only after the attest-record package delivery decision and retention disposition are recorded (M0-D25).",
  "decidesCovers": [
    "D03-09",
    "D25-01",
    "D25-09",
    "D25-14"
  ],
  "decidesAuthored": "2026-10-29",
  "invariantRevisions": [
    {
      "date": "2026-10-29",
      "added": "Lifecycle: registered becomes active only after the slug is confirmed and the first administrator is assigned; active and suspended alternate only by an acting platform operator; active or suspended may start offboarding; offboarding completes only after the attest-record package delivery decision and retention disposition are recorded; every other transition is refused and a repeat of the current state is a no-op."
    }
  ]
}
