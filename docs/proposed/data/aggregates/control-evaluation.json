  "productRules": [
    {
      "id": "D13-02",
      "doc": "m0-d13-control-evaluation.md",
      "rule": "Each procedure step records an assertion (design, implementation, evidence_sufficiency), a method (inquiry, inspection, observation, reperformance), typed inspected items, and an expected condition."
    },
    {
      "id": "D13-04",
      "doc": "m0-d13-control-evaluation.md",
      "rule": "Each step result is met, not_met, or not_tested with a rationale, and per-assertion and overall results are effective, effective_with_exceptions, ineffective, or not_tested."
    },
    {
      "id": "D13-05",
      "doc": "m0-d13-control-evaluation.md",
      "rule": "An overall effective result requires every step of every assertion to be met."
    },
    {
      "id": "D13-06",
      "doc": "m0-d13-control-evaluation.md",
      "rule": "A not_met step creates a ControlEvaluationDeviation that the evaluator classifies as minor or material."
    },
    {
      "id": "D13-08",
      "doc": "m0-d13-control-evaluation.md",
      "rule": "A minor deviation needs a recorded disposition of corrected or accepted_with_waiver, and the overall result is at best effective_with_exceptions."
    },
    {
      "id": "D13-09",
      "doc": "m0-d13-control-evaluation.md",
      "rule": "A deviation never closes merely because a later evaluation passed; closure requires an explicit retest link."
    },
    {
      "id": "D13-12",
      "doc": "m0-d13-control-evaluation.md",
      "rule": "Advisor validated feedback on an evaluation is additive and never counts as the independent review."
    },
    {
      "id": "D13-07",
      "doc": "m0-d13-control-evaluation.md",
      "rule": "A material deviation creates or links a Finding with a corrective action and requires a retest, which is a new evaluation of the same plan version or a successor that explicitly links to the deviation."
    },
    {
      "id": "D23-02",
      "doc": "m0-d23-assurance-vocabulary.md",
      "rule": "A material ControlEvaluationDeviation creates or links to a Finding; the deviation retains the procedure, exact inputs, tester, and original result."
    }
  ],
  "decides": "Each step records an assertion (design, implementation, evidence_sufficiency), a method (inquiry, inspection, observation, reperformance), typed inspected items and an expected condition. A step result is met, not_met or not_tested with a rationale; per-assertion and overall results are effective, effective_with_exceptions, ineffective or not_tested, and overall effective requires every step of every assertion met. A not_met step requires a deviation classified minor or material: a material deviation makes the result ineffective, creates or links a Finding with a corrective action and requires a retest (a new evaluation naming the deviation); a minor deviation needs a disposition of corrected or accepted_with_waiver and the result is at best effective_with_exceptions. A deviation never closes because a later evaluation passed; closure requires an explicit retest link, and the deviation keeps its procedure, exact inputs, tester and original result.",
  "decidesCovers": [
    "D13-02",
    "D13-04",
    "D13-05",
    "D13-06",
    "D13-07",
    "D13-08",
