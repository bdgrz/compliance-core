  "productRules": [
    {
      "id": "D12-01",
      "doc": "m0-d12-policy-acknowledgement-training.md",
      "rule": "Policy audiences are always sets of workforce people from the roster, never platform members, and are never inferred from application access, platform team membership, or the IdP."
    },
    {
      "id": "D12-03",
      "doc": "m0-d12-policy-acknowledgement-training.md",
      "rule": "A core_security audience is every in-scope workforce person (employees and contractors with access to in-scope systems or data); a role_targeted audience is workforce people whose roster team is named on the policy version."
    },
    {
      "id": "D12-04",
      "doc": "m0-d12-policy-acknowledgement-training.md",
      "rule": "A PolicyDistributionCampaign freezes its launch audience by evaluating the audience rule against the roster at launch, and later roster changes never edit the frozen audience."
    },
    {
      "id": "D12-05",
      "doc": "m0-d12-policy-acknowledgement-training.md",
      "rule": "Roster changes during a campaign add attributed audience amendment entries (person, reason joiner/mover_in/mover_out/leaver, roster observation, time); the launch audience plus amendments is the evidence population."
    },
    {
      "id": "D12-15",
      "doc": "m0-d12-policy-acknowledgement-training.md",
      "rule": "A leaver moves to removed in open campaigns and keeps their history."
    },
    {
      "id": "D12-14",
      "doc": "m0-d12-policy-acknowledgement-training.md",
      "rule": "A mover is added by amendment to active role_targeted campaigns of the new team (mover_in) and removed from campaigns of the old team (mover_out), while earlier completions keep their history."
    }
  ],
  "decides": "Audience is always workforce people from the roster, never platform members and never inferred from application access, team membership, or IdP. core_security is every in-scope employee and contractor with access to in-scope systems or data; role_targeted is people whose roster team is named on the version. Roster changes add attributed amendments (person, reason joiner/mover_in/mover_out/leaver, roster observation, time); launch audience plus amendments is the evidence population, joiners due within 30 days of start, and a leaver moves to removed in open campaigns keeping history.",
  "decidesCovers": [
