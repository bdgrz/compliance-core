  "selectedReplayRule": "Current required authorization precedes replay; exact authorized retries resolve the original accepted result using the selected logical identity and immutable actor/intent/source binding. Fresh mutable feasibility, clock selection and body preparation cannot replace that original result. Expected revision is concurrency precondition, not a new identity.",
  "productRules": [
    {
      "id": "D21-04",
      "doc": "m0-d21-significant-change.md",
      "rule": "A ComplianceIncident carries detected_at, resolved_at, and boolean customer_data_affected and availability_sla_affected; it may link to an earlier externally sourced IncidentReference, and linking does not rewrite earlier risk history or weaken the IncidentReference's required source identity, occurrence time, summary, and provenance."
    }
  ],
  "decides": "An incident carries detected_at, resolved_at and boolean customer_data_affected and availability_sla_affected; the recorded time cannot precede detected_at and a revision cannot change detected_at. It may link to an earlier externally sourced IncidentReference; linking never rewrites earlier risk history and the reference keeps its source identity, occurrence time, summary and provenance.",
  "decidesCovers": [
    "D21-04"
  ],
