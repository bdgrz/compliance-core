  "selectedReplayRule": "Current required authorization precedes replay; exact authorized retries resolve the original accepted result using the selected logical identity and immutable actor/intent/source binding. Fresh mutable feasibility, clock selection and body preparation cannot replace that original result. Expected revision is concurrency precondition, not a new identity.",
  "productRules": [
    {
      "id": "D15-05",
      "doc": "m0-d15-work-queue.md",
      "rule": "The identity of a finding-closure work item includes the exact finding revision; revising or reopening a finding creates a new work identity, and an assignment made against an earlier revision cannot authorize or assign the new round."
    },
    {
      "id": "D15-09",
      "doc": "m0-d15-work-queue.md",
      "rule": "An unassigned team work item may be claimed only by a member of that team holding the role the source workflow requires; assign and reassign are limited to a Compliance Lead or Org Admin; delegate is limited to the current assignee and only to someone eligible under the source workflow; escalate may be done by any assignee or by the system."
    },
    {
      "id": "D15-10",
      "doc": "m0-d15-work-queue.md",
      "rule": "Every work-item assignment action is attributed and checked against separation-of-duties rules; an item cannot be assigned to a person the source workflow would reject."
    },
    {
      "id": "D15-11",
      "doc": "m0-d15-work-queue.md",
      "rule": "A work item that is 7 days overdue escalates automatically to the Compliance Lead, recorded as a system-actor escalation; escalation adds visibility only and does not reassign the item."
    }
  ],
  "decides": "Assignment is attributed and refuses a person the source workflow would reject (separation of duties), an unassigned team item is claimed only by a team member holding the source-required role, assign and reassign are limited to Compliance Lead or Org Admin, delegate to the current assignee and only to someone eligible, and escalate by any assignee or the system. The identity of a finding-closure item includes the exact finding revision, so an assignment against an earlier revision cannot authorize the new round, and a system escalation after 7 days overdue targets the Compliance Lead and adds visibility without reassigning.",
  "decidesCovers": [
    "D15-05",
    "D15-09",
    "D15-10",
    "D15-11"
  ],
