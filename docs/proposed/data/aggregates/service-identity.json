      "doc": "m0-d06-workforce-source.md",
      "rule": "Every non-human identity (ServiceIdentity) has exactly one accountable owner, either a person or a team, plus an approved purpose and a review date no more than one year in the future."
    },
    {
      "id": "D22-03",
      "doc": "m0-d22-canonical-ownership.md",
      "rule": "ServiceIdentity (non-human identity) is owned by workforce assurance with an accountable owner relationship; a group or role never becomes a non-human identity."
    }
