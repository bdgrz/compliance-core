  "selectedReplayRule": "Current required authorization precedes replay; exact authorized retries resolve the original accepted result using the selected logical identity and immutable actor/intent/source binding. Fresh mutable feasibility, clock selection and body preparation cannot replace that original result. Expected revision is concurrency precondition, not a new identity.",
  "productRules": [
    {
      "id": "D21-01",
      "doc": "m0-d21-significant-change.md",
      "rule": "An authorized user may record a SignificantChange or ComplianceIncident directly when no source tool exists; the product keeps its own record identity, recorder, dates, assessment, and evidence, and external source_system, source_identifier, and source_url are optional provenance only."
    },
    {
      "id": "D21-02",
      "doc": "m0-d21-significant-change.md",
      "rule": "Significance is a recorded human assessment of significant or not_significant with a required rationale and assessed_by and assessed_at; handling_class uses the evidence vocabulary and defaults to confidential."
    }
  ],
  "decides": "A change records a human significance assessment of significant or not_significant with required rationale, assessed_by and assessed_at, and a handling_class from the evidence vocabulary defaulting to confidential. It is significant when it changes the system boundary, a service commitment or system requirement, a key control, or infrastructure hosting in-scope data; the product keeps its own record identity, recorder and dates, and source_system, source_identifier and source_url are optional provenance only.",
  "decidesCovers": [
    "D21-01",
    "D21-02",
    "D21-03"
  ],
  "decidesAuthored": "2026-10-29"
