  "productRules": [
    {
      "id": "D15-03",
      "doc": "m0-d15-work-queue.md",
      "rule": "The finding remains the authority for required closure evidence, verification rationale, program-management permission, and separation of duties; the work queue never infers or grants a separation-of-duties exception or waiver."
    },
    {
      "id": "D23-01",
      "doc": "m0-d23-assurance-vocabulary.md",
      "rule": "Gap (readiness unmet rule for an exact assessment and as-of time), ProviderCoverageGap, ControlEvaluationDeviation, and Finding are distinct records; none silently changes into another or closes merely because a linked record changes state, and conversion to a Finding preserves source text, provenance, and links."
    }
  ],
  "decides": "A finding closes only with required closure evidence, verification rationale, program-management permission, and separation of duties; it is the sole authority for these and never infers or grants a separation-of-duties exception or waiver. Gaps, provider coverage gaps, and control evaluation deviations are distinct records: conversion to a Finding preserves source text, provenance, and links, and no record silently becomes or closes another when a linked record changes state.",
  "decidesCovers": [
    "D15-03",
    "D23-01"
  ],
  "decidesAuthored": "2026-10-29"
