<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Cntryl.Conventions.Testing.Analyzers" Version="1.0.1" />
    <PackageVersion Include="Cntryl.Conventions.Testing.CodeFixes" Version="1.0.1" />
    <PackageVersion Include="Cntryl.Fitz.Extensions" Version="4.0.0" />
    <PackageVersion Include="Cntryl.Fitz.Testing" Version="4.0.0" />
    <PackageVersion Include="Cntryl.LexKey" Version="0.1.2" />
    <PackageVersion Include="Cntryl.Portia.Abstractions" Version="0.10.0" />
    <PackageVersion Include="Cntryl.Portia.Analyzers" Version="0.10.0" />
    <PackageVersion Include="Cntryl.Portia.AspNetCore" Version="0.10.0" />
    <PackageVersion Include="Cntryl.Portia.Cassie" Version="0.10.0" />
    <PackageVersion Include="Cntryl.Portia.Fitz" Version="0.10.0" />
    <PackageVersion Include="Cntryl.Portia.Mcp" Version="0.10.0" />
    <PackageVersion Include="Cntryl.Portia.Mcp.AspNetCore" Version="0.10.0" />
    <PackageVersion Include="Cntryl.Portia.Mcp.Testing" Version="0.10.0" />
    <PackageVersion Include="Cntryl.Portia.Testing" Version="0.10.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Refresh compatible transitive dependencies; OpenAPI 3 is outside ASP.NET Core 10's supported range. -->
    <PackageVersion Include="Microsoft.Bcl.Cryptography" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Logging" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols" Version="8.23.0" />
