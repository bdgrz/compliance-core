<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Cntryl.Conventions.Testing.Analyzers" Version="1.0.2" />
    <PackageVersion Include="Cntryl.Conventions.Testing.CodeFixes" Version="1.0.2" />
    <PackageVersion Include="Cntryl.Fitz.Extensions" Version="4.3.0" />
    <PackageVersion Include="Cntryl.Fitz.Testing" Version="4.3.0" />
    <PackageVersion Include="Cntryl.LexKey" Version="0.1.2" />
    <PackageVersion Include="Cntryl.Portia.Abstractions" Version="0.14.7" />
    <PackageVersion Include="Cntryl.Portia.Analyzers" Version="0.14.7" />
    <PackageVersion Include="Cntryl.Portia.AspNetCore" Version="0.14.7" />
    <PackageVersion Include="Cntryl.Portia.Cassie" Version="0.14.7" />
    <PackageVersion Include="Cntryl.Portia.Communications.Abstractions" Version="0.14.9" />
    <PackageVersion Include="Cntryl.Portia.Communications.Aws" Version="0.14.7" />
    <PackageVersion Include="Cntryl.Portia.Fitz" Version="0.14.7" />
    <PackageVersion Include="Cntryl.Portia.Mcp" Version="0.14.7" />
    <PackageVersion Include="Cntryl.Portia.Mcp.AspNetCore" Version="0.14.7" />
    <PackageVersion Include="Cntryl.Portia.Mcp.Testing" Version="0.14.7" />
    <PackageVersion Include="Cntryl.Portia.Testing" Version="0.14.7" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Align transitive pins with .NET 11 and its OpenAPI 3 dependency graph. -->
    <PackageVersion Include="Microsoft.Bcl.Cryptography" Version="11.0.0" />
    <PackageVersion Include="AWSSDK.Core" Version="4.1.1.2" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.1" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.4.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Logging" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="xunit.analyzers" Version="2.3.0" />
  </ItemGroup>
</Project>
