# GitHub Packages credentials used only while restoring/building dependencies.
GITHUB_ACTOR=
GITHUB_TOKEN=

# Local published ports.
COMPLIANCE_HTTP_PORT=8080
FITZ_HTTP_PORT=4090
FITZ_TCP_PORT=4091
SQRZL_HTTP_PORT=9000
SQRZL_ADMIN_PORT=9001

# Production identity provider settings (Compose defaults to Development mode).
Compliance__Authentication__Mode=External
Compliance__Authentication__Authority=https://example.us.auth0.com/
Compliance__Authentication__ClientId=
Compliance__Authentication__Scopes="openid profile compliance.read"
Compliance__Authentication__AuthorizationAudience=https://compliance.example/api
Compliance__Authentication__Resources__Badgers__Authority=https://example.us.auth0.com/
Compliance__Authentication__Resources__Badgers__Audience=https://compliance.example/api
BDGRZ_SESSION_SIGNING_KEY=

# Seed the first operator on a new production roster. Later changes use the API or MCP.
# PlatformOperators__UserIds__0=<existing Bdgrz platform user UUID>

# Development defaults to in-process mock delivery. In production, weekly digests, email
# verification, and tenant invitations share the SMTP transport below. Configure the same
# email-delivery settings on API and worker hosts; keep credentials in deployment secrets.
# Email verification and invitation tokens also require a 32-byte base64 key; generate one with:
# openssl rand -base64 32
# Compliance__EmailDelivery__Mode=smtp
# Compliance__EmailDelivery__Smtp__Host=
# Compliance__EmailDelivery__Smtp__Port=587
# Compliance__EmailDelivery__Smtp__FromAddress=
# Compliance__EmailDelivery__Smtp__Username=
# Compliance__EmailDelivery__Smtp__Password=
# Compliance__EmailDelivery__ActiveTokenKeyId=current
# Compliance__EmailDelivery__TokenKeys__current=
# Keep retired token keys available until their invitations expire (up to 7 days).

# Weekly digests also require the canonical HTTPS client origin and a client-owned,
# root-relative work-item route template. The client deployment must supply the route;
# this backend does not define or ship a user-facing route. The template must contain
# {tenant_id}, {tenant_slug}, {program_id}, and {work_item_id}.
# Compliance__WorkDigest__ApplicationOrigin=
# Compliance__WorkDigest__ClientWorkItemRouteTemplate=
# Optional worker timing/retry settings (defaults: 3 attempts, 300s retry delay,
# 144h retry window, 180s attempt lease, and 60s poll interval).
# Compliance__WorkDigest__MaximumAttempts=3
# Compliance__WorkDigest__RetryDelaySeconds=300
# Compliance__WorkDigest__RetryWindowHours=144
# Compliance__WorkDigest__AttemptLeaseSeconds=180
# Compliance__WorkDigest__PollIntervalSeconds=60
